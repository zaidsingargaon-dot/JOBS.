# SkillConnect Environment Configuration
# Firebase credentials placeholder.
# If left empty, SkillConnect automatically operates in Local Persistent Storage Mode (everything saves locally in browser).
# Provide real Firebase credentials below to enable live Google Cloud Firestore and Firebase Auth.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

