# SkillConnect - Firebase Configuration Template
# To connect to live Google Firebase Auth and Cloud Firestore:
# 1. Create a Firebase project at https://console.firebase.google.com/
# 2. Enable Authentication (Email/Password and Anonymous/Phone)
# 3. Create a Cloud Firestore Database in production/test mode
# 4. Copy your web app config credentials below and save as .env

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

