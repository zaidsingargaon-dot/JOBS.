rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/database/documents/users/request.auth.uid).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@skillconnect-admin[.]org')
      );
    }
    
    function isEmployer() {
      return isAuthenticated() && getUserData().role == 'employer';
    }
    
    function isWorker() {
      return isAuthenticated() && getUserData().role == 'worker';
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      // Anyone authenticated can view public worker/employer info (name, skills, rating, general area)
      allow read: if isAuthenticated();
      // Users can create and modify only their own account document
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      // Private subcollection for sensitive worker data (Aadhaar/Govt ID, Bank details, emergency contact)
      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Job Listings Collection
    match /jobs/{jobId} {
      // Any user (even unauthenticated guests browsing the board) can read active, approved jobs
      allow read: if resource.data.status == 'active' && resource.data.isFlagged != true;
      // Employers can read their own jobs regardless of status (active/closed/flagged)
      allow read: if isAuthenticated() && (resource.data.employerId == request.auth.uid || isAdmin());
      
      // Only employers can create jobs with valid required fields
      allow create: if isAuthenticated() && 
                    request.resource.data.employerId == request.auth.uid &&
                    request.resource.data.title is string &&
                    request.resource.data.dailyWage is number &&
                    request.resource.data.dailyWage >= 300; // Protection against severe wage exploitation
      
      // Only job owner or admin can update or delete the job
      allow update: if isAuthenticated() && (resource.data.employerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.employerId == request.auth.uid || isAdmin());
    }

    // 3. Job Applications Collection
    match /applications/{applicationId} {
      // Workers can read their own applications
      // Employers can read applications for jobs they created
      allow read: if isAuthenticated() && (
        resource.data.workerId == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        isAdmin()
      );
      
      // Workers can apply for active jobs
      allow create: if isAuthenticated() && 
                    request.resource.data.workerId == request.auth.uid &&
                    request.resource.data.status == 'applied';
      
      // Employers who own the job can update the application status (shortlisted, accepted, rejected)
      // Workers can update to cancel or withdraw their application
      allow update: if isAuthenticated() && (
        resource.data.employerId == request.auth.uid || 
        resource.data.workerId == request.auth.uid || 
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // 4. Notifications Collection
    match /notifications/{notificationId} {
      // Users can only read and acknowledge their own notifications
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Notifications can be created by the system or triggered during application state changes
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 5. Safety Reports & Fraud Complaints Collection
    match /reports/{reportId} {
      // Authenticated users can submit reports against suspicious jobs, wage fraud, or unsafe employers
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      // Only administrators can read, triage, and manage safety reports
      allow read, update, delete: if isAdmin();
    }

    // 6. Saved / Bookmarked Jobs Collection
    match /savedJobs/{savedId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}

